// Prisma schema — Deep-Tech Reichman dietary preferences.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Member {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique // stored lower-cased; one record per email
  phone          String?
  vegetarian     Boolean  @default(false)
  vegan          Boolean  @default(false)
  kosher         Boolean  @default(false)
  celiac         Boolean  @default(false)
  hasAllergy     Boolean  @default(false)
  allergyDetails String?
  allergySevere  Boolean  @default(false) // life-threatening / carries an EpiPen
  notes          String?
  consentAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Fixed-window rate-limit counters. Kept in Postgres so limits hold across
// serverless instances on Vercel (in-memory counters would not).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
