// Prisma schema — Deep-Tech Reichman dietary preferences.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Member {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique // stored lower-cased; one record per email
  phone          String?
  vegetarian     Boolean  @default(false)
  vegan          Boolean  @default(false)
  kosher         Boolean  @default(false)
  celiac         Boolean  @default(false)
  hasAllergy     Boolean  @default(false)
  allergyDetails String?
  allergySevere  Boolean  @default(false) // life-threatening / carries an EpiPen
  notes          String?
  consentAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Fixed-window rate-limit counters. Kept in Postgres so limits hold across
// serverless instances on Vercel (in-memory counters would not).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// A club meetup/lecture that members can give feedback on.
// The admin marks one as active; the public feedback form attaches to it.
model ClubEvent {
  id        String     @id @default(cuid())
  title     String
  speaker   String?
  date      DateTime
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  feedback  Feedback[]

  @@index([isActive])
}

// "שימור / שיפור" feedback for one event. Name is optional (empty = anonymous).
model Feedback {
  id             String    @id @default(cuid())
  eventId        String
  event          ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lectureRating  Int
  lectureKeep    String?
  lectureImprove String?
  foodRating     Int?
  foodKeep       String?
  foodImprove    String?
  notes          String?
  name           String?
  createdAt      DateTime  @default(now())

  @@index([eventId])
}

// One row per claimed (or admin-blocked) Tuesday on the lecture sign-up board.
// The date is the primary key, so two people can't claim the same day.
model LectureSlot {
  date        DateTime @id // the Tuesday, stored at 12:00 UTC
  name        String?
  topic       String?
  email       String? // private — admins only
  blocked     Boolean  @default(false) // admin: no meetup that day
  cancelToken String? // lets the claimer cancel from the same device
  createdAt   DateTime @default(now())

  @@index([email])
}
