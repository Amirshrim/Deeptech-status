# ─── Database ──────────────────────────────────────────────
# Pooled connection string — used by the app at runtime.
# On Vercel + Neon this is set for you by the Neon integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deeptech_diet?schema=public"
# Direct (non-pooled) connection — used by `prisma migrate`.
# Neon's integration sets this too. Locally it can equal DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/deeptech_diet?schema=public"

# ─── Admin auth ────────────────────────────────────────────
# Comma-separated allowlist of admin emails (case-insensitive).
ADMIN_EMAILS="admin@example.com,second.admin@example.com"
# bcrypt hash of the shared admin password. Generate with:  npm run hash-password
# In a local .env file every "$" must be escaped as "\$" (the script prints this form).
# In the Vercel dashboard paste the raw hash, no escaping.
ADMIN_PASSWORD_HASH=""
# Secret used to sign session cookies. At least 32 random characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ─── Public form ───────────────────────────────────────────
# Shown in the privacy note as the address for deletion requests.
CLUB_CONTACT_EMAIL="deeptech@example.com"
