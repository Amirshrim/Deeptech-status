{
  "name": "deeptech-diet",
  "version": "1.0.0",
  "private": true,
  "description": "Deep-Tech Reichman — dietary preferences form and admin dashboard",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
